diff --git a/src/wiz8/zh_text/HiResTextLayer.cpp b/src/wiz8/zh_text/HiResTextLayer.cpp
new file mode 100644
index 0000000..20b6434
--- /dev/null
+++ b/src/wiz8/zh_text/HiResTextLayer.cpp
@@ -0,0 +1,303 @@
+#include "wiz8/zh_text/HiResTextLayer.h"
+#include "wiz8/zh_text/HiResTextRasterizer.h"
+
+#include "wiz8/canvas.h"
+#include "wiz8/engine_code/Video2.h"
+#include "wiz8/surface2d.h"
+#include "surrender/srColorSurface.h"
+#include "surrender/srGERD.h"
+#include "surrender/srShader.h"
+#include <windows.h>
+#include <stdlib.h>
+#include <string.h>
+
+namespace {
+
+// POD only: Hybrid intentionally removes dynamic global initialization.
+struct TextLayerState {
+    int config_read;
+    int enabled;
+    int text_mode;
+    int failed;
+    int width;
+    int height;
+    unsigned long* pixels;
+    srColorSurface* surface;
+    stSurface2D* layer;
+    HiResTextMetrics metrics[9];
+    int metric_count;
+};
+
+static TextLayerState g_text;
+
+bool WriteBytes(const char* path, const void* bytes, unsigned long count)
+{
+    HANDLE file = CreateFileA(path, GENERIC_WRITE, FILE_SHARE_READ, 0, CREATE_ALWAYS,
+                              FILE_ATTRIBUTE_NORMAL, 0);
+    if (file == INVALID_HANDLE_VALUE) {
+        return false;
+    }
+    DWORD written = 0;
+    bool ok = WriteFile(file, bytes, count, &written, 0) != 0 && written == count;
+    CloseHandle(file);
+    return ok;
+}
+
+void ReadConfig()
+{
+    if (!g_text.config_read) {
+        char path[MAX_PATH];
+        PathNextToExe("wiz8zhtw.ini", path, sizeof(path));
+        g_text.enabled = GetPrivateProfileIntA("ZH-TW", "Enabled", 0, path) != 0;
+        char phase[32];
+        DWORD phase_length = GetEnvironmentVariableA("WIZ8_ZHTW_POC_PHASE", phase, sizeof(phase));
+        g_text.text_mode = phase_length > 0 && phase_length < sizeof(phase) && phase[0] == 't';
+        g_text.config_read = 1;
+        CanvasLogLine(!g_text.enabled ? "[ZH-TW] disabled: no overlay resources" :
+                      g_text.text_mode ? "[ZH-TW] enabled: physical-resolution text proof" :
+                                         "[ZH-TW] enabled: alpha proof");
+    }
+}
+
+void FillRect(int left, int top, int right, int bottom, unsigned long pixel)
+{
+    for (int y = top; y < bottom; ++y) {
+        for (int x = left; x < right; ++x) {
+            g_text.pixels[y * g_text.width + x] = pixel;
+        }
+    }
+}
+
+bool Initialize(srGERD* renderer)
+{
+    g_text.width = renderer->getWidth();
+    g_text.height = renderer->getHeight();
+    if (g_text.width != 1920 || g_text.height != 1080) {
+        CanvasLogLine("[ZH-TW] blocked: formal proof requires 1920x1080");
+        return false;
+    }
+    g_text.pixels = static_cast<unsigned long*>(calloc(g_text.width * g_text.height, 4));
+    if (g_text.pixels == 0) {
+        return false;
+    }
+    if (g_text.text_mode) {
+        const wchar_t* strings[3] = {
+            L"\u5deb\u8853 8",
+            L"\u7e41\u9ad4\u4e2d\u6587\u9ad8\u89e3\u6790\u6587\u5b57\u6e2c\u8a66",
+            L"Wizardry 8 ZH-TW"
+        };
+        const int sizes[3] = {24, 32, 48};
+        const int tops[3] = {40, 174, 350};
+        const int advances[3] = {36, 44, 64};
+        for (int size = 0; size < 3; ++size) {
+            for (int line = 0; line < 3; ++line) {
+                HiResTextMetrics* metrics = &g_text.metrics[g_text.metric_count];
+                if (!HiResTextRasterize(strings[line], 48, tops[size] + line * advances[size],
+                                        sizes[size], 0x00ffeba0UL, g_text.pixels,
+                                        g_text.width, g_text.height, metrics)) {
+                    CanvasLogLine("[ZH-TW] rasterization failed or missing glyph; original UI retained");
+                    return false;
+                }
+                ++g_text.metric_count;
+            }
+        }
+    } else {
+        // Straight alpha; RGB is deliberately identical for every alpha value.
+        const unsigned long rgb = (220UL << 16) | (180UL << 8) | 80UL;
+        const int alpha[5] = {0, 64, 128, 192, 255};
+        for (int index = 0; index < 5; ++index) {
+            FillRect(48 + index * 152, 48, 176 + index * 152, 128,
+                     rgb | (static_cast<unsigned long>(alpha[index]) << 24));
+        }
+        for (int value = 0; value < 256; ++value) {
+            FillRect(48 + value * 3, 160, 51 + value * 3, 208,
+                     rgb | (static_cast<unsigned long>(value) << 24));
+        }
+    }
+    g_text.surface = new srColorSurface(srPixelConvert::SURFACE_BGRA32, g_text.pixels,
+                                        g_text.width, g_text.height, g_text.width * 4);
+    if (g_text.surface == 0) {
+        return false;
+    }
+    g_text.layer = new stSurface2D(g_text.surface, g_text.width, g_text.height, 0,
+                                   SurfaceTileExtent(g_text.width, g_text.height));
+    if (g_text.layer == 0) {
+        return false;
+    }
+    g_text.layer->shader_bits = srShader::PASS_ALWAYS | srShader::MASK_COLOR_WRITE |
+        (srShader::DSTBLEND_ONE_MINUS_SRC_ALPHA << srShader::DSTBLEND_SHIFT) |
+        (srShader::SRCBLEND_SRC_ALPHA << srShader::SRCBLEND_SHIFT) |
+        srShader::MASK_TEXTURING;
+    for (int index = 0; index < g_text.layer->tile_count; ++index) {
+        stTexture2D* tile = g_text.layer->tiles[index];
+        tile->disableHint(srTextureIFace::HINT_NO_ALPHA);
+        tile->disableHint(srTextureIFace::HINT_ONE_BIT_ALPHA);
+        tile->enableHint(srTextureIFace::HINT_NO_REDUCTION);
+        tile->setMagFilter(srTextureIFace::FILTER_NONE);
+        tile->setMinFilter(srTextureIFace::FILTER_NONE);
+        tile->invalidate();
+    }
+    CanvasLogLine(g_text.text_mode ? "[ZH-TW] GDI text surface initialized: physical 1920x1080, 24/32/48 px" :
+                                    "[ZH-TW] alpha surface initialized: 1920x1080 BGRA32 straight alpha");
+    return true;
+}
+
+void DescribeFormat(char* text, const char* label, const srPixelConvert::PixelFormat& format)
+{
+    wsprintfA(text, "%s_r_bits=%u\n%s_r_shift=%u\n%s_g_bits=%u\n%s_g_shift=%u\n"
+                   "%s_b_bits=%u\n%s_b_shift=%u\n%s_a_bits=%u\n%s_a_shift=%u\n",
+              label, format.red_bits, label, format.red_shift,
+              label, format.green_bits, label, format.green_shift,
+              label, format.blue_bits, label, format.blue_shift,
+              label, format.alpha_bits, label, format.alpha_shift);
+}
+
+} // namespace
+
+void HiResTextDrawFrame(srGERD* renderer)
+{
+    ReadConfig();
+    if (!g_text.enabled || g_text.failed || renderer == 0) {
+        return;
+    }
+    if (g_text.layer == 0 && !Initialize(renderer)) {
+        g_text.failed = 1;
+        CanvasLogLine("[ZH-TW] initialization failed; original renderer remains active");
+        return;
+    }
+
+    if (!g_text.text_mode) {
+        // Test background is cleared independently of the alpha texture.
+        srVector4T<float> saved_clear;
+        renderer->getClearColor(saved_clear);
+        renderer->setViewPort(32, 32, 800, 192);
+        renderer->setScissor(32, 32, 800, 192);
+        renderer->setClearColor(20.0f / 255.0f, 40.0f / 255.0f, 60.0f / 255.0f, 1.0f);
+        renderer->clear(srFlags<srGERD::e_buffer>(srGERD::BUFFER_COLOR));
+        renderer->setClearColor(saved_clear);
+    }
+    renderer->setViewPort(0, 0, g_text.width, g_text.height);
+    renderer->setScissor(0, 0, g_text.width, g_text.height);
+
+    srGERD::e_matrixMode old_mode = renderer->getMatrixMode();
+    srShader old_shader = renderer->getShader();
+    renderer->matrixMode(srGERD::MATRIX_MODELVIEW);
+    renderer->pushMatrix();
+    renderer->loadIdentity();
+    g_text.layer->DrawTiles(renderer);
+    renderer->flushRenderers();
+    renderer->matrixMode(srGERD::MATRIX_MODELVIEW);
+    renderer->popMatrix();
+    renderer->matrixMode(old_mode);
+    renderer->setShader(old_shader);
+}
+
+void HiResTextReadback(srGERD* renderer)
+{
+    char request[MAX_PATH];
+    PathNextToExe("zhtwshot.req", request, sizeof(request));
+    if (renderer == 0 || GetFileAttributesA(request) == INVALID_FILE_ATTRIBUTES) {
+        return;
+    }
+    char directory[MAX_PATH];
+    DWORD length = GetEnvironmentVariableA("WIZ8_ZHTW_CAPTURE_DIR", directory, sizeof(directory));
+    if (length == 0 || length >= sizeof(directory)) {
+        CanvasLogLine("[ZH-TW] capture requires WIZ8_ZHTW_CAPTURE_DIR");
+        DeleteFileA(request);
+        return;
+    }
+    CreateDirectoryA(directory, 0);
+    srColorSurfaceIFace* frame = renderer->lockBuffer();
+    if (frame == 0) {
+        CanvasLogLine("[ZH-TW] lockBuffer failed; capture not accepted");
+        DeleteFileA(request);
+        return;
+    }
+    int width = frame->getWidth();
+    int height = frame->getHeight();
+    unsigned long* row = static_cast<unsigned long*>(malloc(width * 4));
+    char path[MAX_PATH];
+    wsprintfA(path, "%s\\readback.bgra", directory);
+    HANDLE file = CreateFileA(path, GENERIC_WRITE, FILE_SHARE_READ, 0, CREATE_ALWAYS,
+                              FILE_ATTRIBUTE_NORMAL, 0);
+    bool ok = row != 0 && file != INVALID_HANDLE_VALUE;
+    if (ok) {
+        for (int y = 0; y < height; ++y) {
+            frame->getPixelRow(row, y, 0, width);
+            for (int x = 0; x < width; ++x) {
+                row[x] |= 0xff000000UL;
+            }
+            DWORD written = 0;
+            if (!WriteFile(file, row, width * 4, &written, 0) || written != width * 4) {
+                ok = false;
+                break;
+            }
+        }
+    }
+    if (file != INVALID_HANDLE_VALUE) {
+        CloseHandle(file);
+    }
+    free(row);
+    srPixelConvert::PixelFormat frame_format;
+    frame->getPixelFormat(frame_format);
+    renderer->unlockBuffer();
+
+    char metadata[4096];
+    wsprintfA(metadata, "phase=%s\nenabled=%d\nrenderer_width=%lu\nrenderer_height=%lu\n"
+                        "readback_width=%d\nreadback_height=%d\noverlay_width=%d\noverlay_height=%d\n"
+                        "alpha_contract=straight\nforeground_rgb=220,180,80\nbackground_rgb=20,40,60\n"
+                        "normalized_readback=BGRA32_opaque\nreadback_ok=%d\n",
+              !g_text.enabled ? "FEATURE_OFF" : g_text.text_mode ? "P1B" : "P1A",
+              g_text.enabled, renderer->getWidth(), renderer->getHeight(), width, height,
+              g_text.width, g_text.height, ok ? 1 : 0);
+    char line[512];
+    DescribeFormat(line, "readback_native", frame_format);
+    strcat(metadata, line);
+    if (g_text.layer != 0) {
+        srPixelConvert::PixelFormat source_format;
+        g_text.surface->getPixelFormat(source_format);
+        DescribeFormat(line, "source", source_format);
+        strcat(metadata, line);
+        srGERD::TextureInfo texture;
+        memset(&texture, 0, sizeof(texture));
+        int texture_result = renderer->getTextureInfo(g_text.layer->tiles[0], texture);
+        wsprintfA(line, "texture_query_result=%d\ntexture_width=%lu\ntexture_height=%lu\n"
+                        "tile_count=%d\nshader_bits=0x%08lx\n",
+                  texture_result, texture.width, texture.height, g_text.layer->tile_count,
+                  g_text.layer->shader_bits);
+        strcat(metadata, line);
+        DescribeFormat(line, "texture", texture.pixel_format);
+        strcat(metadata, line);
+        if (g_text.text_mode) {
+            strcat(metadata, "text_rgb=255,235,160\nfont_pixel_sizes=24,32,48\n");
+            for (int index = 0; index < g_text.metric_count; ++index) {
+                const HiResTextMetrics& metric = g_text.metrics[index];
+                wsprintfA(line, "run_%d=%d,%d,%d,%d,%d,%d,%d,%d,%d\n",
+                          index, metric.x, metric.y, metric.font_px, metric.width,
+                          metric.cell_height, metric.ascent, metric.descent,
+                          metric.missing_glyphs, metric.intermediate_pixels);
+                strcat(metadata, line);
+            }
+            wsprintfA(line, "font_name=%s\n", g_text.metrics[0].font_face_utf8);
+            strcat(metadata, line);
+        }
+        wsprintfA(path, "%s\\source.bgra", directory);
+        ok = WriteBytes(path, g_text.pixels, g_text.width * g_text.height * 4) && ok;
+    }
+    wsprintfA(path, "%s\\render-info.txt", directory);
+    ok = WriteBytes(path, metadata, static_cast<unsigned long>(strlen(metadata))) && ok;
+    CanvasLogLine(ok ? "[ZH-TW] lossless readback completed" : "[ZH-TW] readback write failed");
+    DeleteFileA(request);
+}
+
+void HiResTextShutdown()
+{
+    if (g_text.layer != 0) {
+        g_text.layer->release();
+    }
+    if (g_text.surface != 0) {
+        g_text.surface->release();
+    }
+    free(g_text.pixels);
+    memset(&g_text, 0, sizeof(g_text));
+}
diff --git a/src/wiz8/zh_text/HiResTextRasterizerGDI.cpp b/src/wiz8/zh_text/HiResTextRasterizerGDI.cpp
new file mode 100644
index 0000000..9397057
--- /dev/null
+++ b/src/wiz8/zh_text/HiResTextRasterizerGDI.cpp
@@ -0,0 +1,103 @@
+#include "wiz8/zh_text/HiResTextRasterizer.h"
+
+#include <windows.h>
+#include <stdlib.h>
+#include <string.h>
+
+bool HiResTextRasterize(const wchar_t* text, int x, int y, int font_px,
+                       unsigned long rgb, unsigned long* target, int width, int height,
+                       HiResTextMetrics* metrics)
+{
+    if (text == 0 || target == 0 || metrics == 0 || width <= 0 || height <= 0) {
+        return false;
+    }
+    memset(metrics, 0, sizeof(*metrics));
+    metrics->x = x;
+    metrics->y = y;
+    metrics->font_px = font_px;
+    int length = lstrlenW(text);
+    HDC dc = CreateCompatibleDC(0);
+    if (dc == 0) {
+        return false;
+    }
+    BITMAPINFO bitmap_info;
+    memset(&bitmap_info, 0, sizeof(bitmap_info));
+    bitmap_info.bmiHeader.biSize = sizeof(BITMAPINFOHEADER);
+    bitmap_info.bmiHeader.biWidth = width;
+    bitmap_info.bmiHeader.biHeight = -height;
+    bitmap_info.bmiHeader.biPlanes = 1;
+    bitmap_info.bmiHeader.biBitCount = 32;
+    bitmap_info.bmiHeader.biCompression = BI_RGB;
+    void* dib_pixels = 0;
+    HBITMAP bitmap = CreateDIBSection(dc, &bitmap_info, DIB_RGB_COLORS, &dib_pixels, 0, 0);
+    HFONT font = CreateFontW(-font_px, 0, 0, 0, FW_NORMAL, FALSE, FALSE, FALSE,
+                             DEFAULT_CHARSET, OUT_DEFAULT_PRECIS, CLIP_DEFAULT_PRECIS,
+                             ANTIALIASED_QUALITY, DEFAULT_PITCH, L"Microsoft JhengHei");
+    if (bitmap == 0 || font == 0 || dib_pixels == 0) {
+        if (bitmap != 0) DeleteObject(bitmap);
+        if (font != 0) DeleteObject(font);
+        DeleteDC(dc);
+        return false;
+    }
+    HGDIOBJ old_bitmap = SelectObject(dc, bitmap);
+    HGDIOBJ old_font = SelectObject(dc, font);
+    memset(dib_pixels, 0, width * height * 4);
+    SetTextColor(dc, RGB(255, 255, 255));
+    SetBkMode(dc, TRANSPARENT);
+
+    TEXTMETRICW text_metrics;
+    SIZE extent;
+    bool ok = GetTextMetricsW(dc, &text_metrics) != 0 &&
+              GetTextExtentPoint32W(dc, text, length, &extent) != 0;
+    wchar_t face[128];
+    if (GetTextFaceW(dc, 128, face) > 0) {
+        WideCharToMultiByte(CP_UTF8, 0, face, -1, metrics->font_face_utf8,
+                            sizeof(metrics->font_face_utf8), 0, 0);
+    }
+    WORD* glyphs = static_cast<WORD*>(malloc(length * sizeof(WORD)));
+    if (glyphs == 0 || GetGlyphIndicesW(dc, text, length, glyphs,
+                                      GGI_MARK_NONEXISTING_GLYPHS) == GDI_ERROR) {
+        ok = false;
+    } else {
+        for (int index = 0; index < length; ++index) {
+            if (glyphs[index] == 0xffff) {
+                ++metrics->missing_glyphs;
+            }
+        }
+        ok = ok && metrics->missing_glyphs == 0;
+    }
+    free(glyphs);
+    if (ok) {
+        metrics->width = extent.cx;
+        metrics->cell_height = text_metrics.tmHeight;
+        metrics->ascent = text_metrics.tmAscent;
+        metrics->descent = text_metrics.tmDescent;
+        ok = x >= 0 && y >= 0 && x + extent.cx <= width &&
+             y + text_metrics.tmHeight <= height;
+    }
+    if (ok) {
+        ok = TextOutW(dc, x, y, text, length) != 0 && GdiFlush() != 0;
+    }
+    // GDI's DIB alpha is ignored. Grayscale coverage becomes explicit straight alpha.
+    if (ok) {
+        const unsigned long* mask = static_cast<const unsigned long*>(dib_pixels);
+        for (int index = 0; index < width * height; ++index) {
+            unsigned long value = mask[index];
+            unsigned long coverage = value & 0xff;
+            if (((value >> 8) & 0xff) != coverage || ((value >> 16) & 0xff) != coverage) {
+                ok = false; // ClearType/subpixel output is not valid grayscale coverage.
+                break;
+            }
+            if (coverage != 0) {
+                target[index] = (coverage << 24) | (rgb & 0x00ffffffUL);
+                if (coverage != 255) ++metrics->intermediate_pixels;
+            }
+        }
+    }
+    SelectObject(dc, old_font);
+    SelectObject(dc, old_bitmap);
+    DeleteObject(font);
+    DeleteObject(bitmap);
+    DeleteDC(dc);
+    return ok;
+}
