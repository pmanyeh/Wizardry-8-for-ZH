+struct HiResTextMetrics {
+    int x;
+    int y;
+    int font_px;
+    int width;
+    int cell_height;
+    int ascent;
+    int descent;
+    int missing_glyphs;
+    int intermediate_pixels;
+    char font_face_utf8[128];
